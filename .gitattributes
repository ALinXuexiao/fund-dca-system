* text=auto eol=lf

# C# / .NET
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.json text eol=crlf
*.config text eol=crlf
*.razor text eol=crlf

# 前端
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.css text eol=lf
*.html text eol=lf

# Windows 启动脚本：cmd 在 call 场景下遇到 LF 结尾会误解析
# （曾导致 logs\backend.err.log 里出现「'Backend' 不是内部或外部命令」），必须固定 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# WSH(VBScript) 使用 UTF-16LE 编码，禁止 git 改写换行与编码
*.vbs binary

# 二进制
*.png binary
*.jpg binary
*.ico binary
*.gif binary
*.svg text
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
